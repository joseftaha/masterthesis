# cluster.env — site-specific identity. Copy to cluster.env and edit.
#
# This file is sourced by env.sh BEFORE any defaults are applied, so any
# variable set here wins. Anything not set falls through to the defaults
# in env.sh (which match the chapter 8 reference setup).
#
# Bring-up checklist for a new site:
#   1. cp cluster.env.template cluster.env
#   2. fill in EXP_PARTITION, EXP_ACCOUNT, EXP_QOS as your scheduler needs
#   3. set HF_TOKEN to a valid token with access to gated meta-llama weights
#   4. point HF_HOME at a node-local NVMe scratch path large enough for
#      both Llama-3 checkpoints (~200 GB combined)
#   5. (optional) set EXP_MODULE_LOAD if the site uses Lmod modules to
#      provide CUDA/Python rather than a venv
#
# After editing, source env.sh once on a login node to sanity-check the
# resolved values:
#   $ source env.sh && env | grep '^EXP_\|^HF_'

# --- 1. Slurm identity ------------------------------------------------
export EXP_PARTITION="gpu"
export EXP_ACCOUNT=""           # required on most clusters
export EXP_QOS=""
export EXP_NODE_CONSTRAINT="a40"

# Per-job wall-clock caps (override only if your scheduler is stricter).
# export EXP_TIME_WARM="06:00:00"
# export EXP_TIME_COLD="06:00:00"
# export EXP_TIME_BATCH="04:00:00"
# export EXP_TIME_MEASURE="02:00:00"

# --- 2. Hugging Face credentials and cache ----------------------------
export HF_TOKEN=""              # required for gated meta-llama weights
export HF_HOME="/scratch/$USER/hf-cache"

# --- 3. Software stack ------------------------------------------------
# Either set EXP_MODULE_LOAD to a space-separated list of Lmod modules,
# OR pre-build a venv at $EXP_VENV (default: $EXP_ROOT/.venv-real).
# At least one of these must work on the compute node.
# export EXP_MODULE_LOAD="cuda/12.4 python/3.11"
# export EXP_VENV="$EXP_ROOT/.venv-real"
